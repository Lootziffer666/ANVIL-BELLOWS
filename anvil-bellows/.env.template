# ============================================================================
# Anvil-Bellows Proxy — .env Vorlage
# ============================================================================
# Diese Datei enthaelt NUR Platzhalter, niemals echte Keys.
# setup.sh / setup_windows.ps1 / build_portable.ps1 kopieren sie EINMALIG nach
# `.env`, falls dort noch keine existiert ("if not exist .env"). Eine bereits
# vorhandene `.env` mit deinen echten Keys wird NIE ueberschrieben.
#
# Vorgehen:
#   1. setup ausfuehren (legt .env aus dieser Vorlage an)
#   2. .env mit deinen echten Werten ausfuellen
#   3. run_proxy.sh / run_proxy_windows.ps1 starten
#
# Hinweis: `.env` ist via .gitignore ausgeschlossen und landet nie im Repo.
# ============================================================================

# --- ERFORDERLICH -----------------------------------------------------------

# Google Cloud Projekt-ID fuer Vertex AI (Gemini-Modelle)
GOOGLE_PROJECT_ID=your-gcp-project-id

# Vertex AI Region (Standard: us-central1)
GOOGLE_LOCATION=us-central1

# Pfad zur Service-Account-JSON fuer Vertex AI Auth
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# OpenRouter API-Key (fuer die kostenlosen OpenRouter-Modelle)
#   Format: sk-or-...
OPENROUTER_API_KEY=

# Master-Key des Proxys (clientseitiges Bearer-Token gegen den Proxy).
# Bitte durch einen eigenen, sicheren Wert ersetzen.
LITELLM_MASTER_KEY=sk-anvil-safe-key

# --- OPTIONAL ----------------------------------------------------------------

# Host/Port des laufenden Proxys (genutzt von model_manager.py / guard_stats.py)
# LITELLM_HOST=http://localhost:4000

# Lokales Ollama (falls ollama-Modelle in config.yaml aktiviert werden)
# OLLAMA_HOST=http://localhost:11434
